{
  "schema_version": 3,
  "notes": "Retailer feeds. Shopify stores use the public /collections/<handle>/products.json feed, which their robots.txt allows. Add a store by copying an entry. seller.trust is 0-1: authorized retailer with returns ~0.9, consignment/marketplace ~0.7. shipping.flat is only set when the retailer publishes it; otherwise shipping is shown as unknown.",
  "sources": [
    {
      "id": "evo",
      "name": "evo",
      "adapter": "shopify",
      "base_url": "https://www.evo.com",
      "seller": {
        "type": "retailer",
        "trust": 0.92,
        "returns": true
      },
      "feeds": [
        {
          "collection": "sale-skis",
          "kind": "ski",
          "condition": "new",
          "max_pages": 4
        },
        {
          "collection": "used-skis",
          "kind": "ski",
          "condition": "used",
          "max_pages": 4
        }
      ]
    },
